{
  "name": "script-reader",
  "version": "0.3.21",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "build:demo": "npm run build && node scripts/build-demo.mjs",
    "test:browser": "node scripts/check-output.mjs",
    "publish:script": "tsx scripts/publish.ts",
    "dev:hosted": "tsx scripts/dev-hosted.ts",
    "preview:cloudflare": "wrangler pages dev dist",
    "test:hosted-browser": "tsx scripts/check-hosted.ts",
    "check:exposure": "node scripts/check-exposure.mjs",
    "test:admin-browser": "tsx scripts/check-admin.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "papaparse": "^5.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^28.0.0",
    "playwright": "^1.64.1",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
